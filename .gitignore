# Allowlist: only the app's source and setup files go to GitHub.
# Everything else in this folder (personal notes, audit reports, scratch tools,
# test images, Finder files) stays on this Mac.
/*
!/.gitignore
!/README.md
!/main.swift
!/pdftext.swift
!/icon.swift
!/build.sh
!/Info.plist
# Named one by one, so a stray file dropped into these folders never goes public.
!/Resources/
/Resources/*
!/Resources/server.py
!/Resources/doc_clean.py
!/Resources/LocalAI.icns
!/Resources/ui/
/Resources/ui/*
!/Resources/ui/index.html
!/setup/
/setup/*
!/setup/models.json
!/setup/pyenv/
/setup/pyenv/*
!/setup/pyenv/requirements.lock
!/setup/imagegen/
/setup/imagegen/*
!/setup/imagegen/constraints.txt
!/setup/imagegen/requirements.lock
!/setup/imagegen/z-image-turbo-q4/
/setup/imagegen/z-image-turbo-q4/*
!/setup/imagegen/z-image-turbo-q4/REVISION
!/setup/imagegen/z-image-turbo-q4/SHA256SUMS
!/setup/imagegen/flux2-klein-4b-q4/
/setup/imagegen/flux2-klein-4b-q4/*
!/setup/imagegen/flux2-klein-4b-q4/REVISION
!/setup/imagegen/flux2-klein-4b-q4/SHA256SUMS
.DS_Store
